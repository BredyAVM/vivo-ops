import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import test from 'node:test';
import { PGlite } from '@electric-sql/pglite';

const db = new PGlite();
const admin = '00000000-0000-4000-8000-000000000001';
const advisor = '00000000-0000-4000-8000-000000000002';
const stranger = '00000000-0000-4000-8000-000000000003';
const migration = readFileSync(new URL('../../supabase/migrations/20261014145247_advisor_commission_live_collections.sql', import.meta.url),'utf8');
await db.exec(`
create role anon; create role authenticated; create role service_role;
create schema auth; create schema app_private;
create function auth.uid() returns uuid language sql as $$select nullif(current_setting('test.uid',true),'')::uuid$$;
create table auth.users(id uuid primary key);
insert into auth.users values('${admin}'),('${advisor}'),('${stranger}');
create table public.profiles(id uuid primary key,full_name text,is_active boolean);
insert into profiles values('${admin}','Admin',true),('${advisor}','Asesor',true),('${stranger}','Otro asesor',true);
create table public.user_roles(user_id uuid,role text);
insert into user_roles values('${admin}','admin'),('${advisor}','advisor'),('${stranger}','advisor');
create table public.clients(id bigint primary key,full_name text);
insert into clients values(1,'Cliente');
create table public.orders(id bigint primary key,client_id bigint,status text,total_usd numeric,pending_usd numeric);
insert into orders values(1,1,'delivered',20,20),(2,1,'delivered',10,0),(3,1,'delivered',50,0);
create table public.money_accounts(id bigint primary key,name text,currency_code text,is_active boolean);
insert into money_accounts values(1,'USD','USD',true),(2,'VES','VES',true);
create table public.money_movements(id bigint generated by default as identity primary key,movement_date date,
created_at timestamptz default now(),created_by_user_id uuid,confirmed_at timestamptz,confirmed_by_user_id uuid,
direction text,movement_type text,money_account_id bigint,currency_code text,amount numeric,exchange_rate_ves_per_usd numeric,
amount_usd_equivalent numeric,reference_code text,counterparty_name text,description text,movement_group_id uuid,status text,
approval_required boolean,voided_at timestamptz,voided_by_user_id uuid,void_reason text);
create table public.advisor_commission_periods(id bigint primary key,name text,date_from date,date_to date,status text default 'open');
insert into advisor_commission_periods values(1,'Uno','2026-09-16','2026-09-30','open'),(2,'Dos','2026-10-01','2026-10-15','open'),(3,'Tres','2026-10-16','2026-10-31','open');
create table public.advisor_commission_closures(id bigint primary key,period_id bigint,advisor_user_id uuid,status text,
gross_commission_usd numeric default 0,gift_deductions_usd numeric default 0,manual_deductions_usd numeric default 0,
pending_collection_usd numeric default 0,payable_usd numeric default 0,snapshot jsonb,generated_at timestamptz default now(),
updated_at timestamptz default now(),closed_at timestamptz,closed_by_user_id uuid,paid_at timestamptz,paid_by_user_id uuid);
create table public.advisor_commission_deductions(id bigint generated by default as identity,closure_id bigint,deduction_type text,amount_usd numeric);
create function public.get_orders_financial_state(bigint[]) returns table(order_id bigint,total_usd numeric,pending_usd numeric,
confirmed_paid_usd numeric,delivery_reference_date date,payment_status text) language sql as $$
select id,total_usd,pending_usd,total_usd-pending_usd,'2026-09-30'::date,case when pending_usd=0 then 'paid' else 'partial' end from public.orders where id=any($1)$$;
create function public.admin_finance_commissions_read_v1() returns jsonb language sql as $$select '{}'::jsonb$$;
grant usage on schema public,auth to authenticated;
grant select,insert,update,delete on all tables in schema public to authenticated;
grant usage on all sequences in schema public to authenticated;
set test.uid='${admin}';
`);
await db.exec(readFileSync(new URL('../../supabase/migrations/20260910223237_commission_payment_atomic_v1.sql',import.meta.url),'utf8'));

const snapshot = (payable: number, carried = 0, retained = 20, orderIds = [1], carrySource = 'settlement') => ({
  version: 2, advisor: { name: 'Asesor' }, totals: { payableUsd: payable },
  settlement: { formulaVersion: 'advisor-settlement-v1', carriedCommissionUsd: carried, retainedCommissionUsd: retained, carrySource },
  commissionWorkflow: { conformity: { status: 'confirmed' } }, orders: orderIds.map(orderId => ({ orderId })),
});
await db.query(`insert into advisor_commission_closures(id,period_id,advisor_user_id,status,gross_commission_usd,pending_collection_usd,payable_usd,snapshot,closed_by_user_id)
values(1,1,$1,'closed',100,20,80,$2,$3),(2,2,$1,'preliminary',10,0,30,$4,null),(3,3,$1,'preliminary',10,0,10,$5,null),
(4,1,$6,'closed',10,0,10,$7,$3),(5,1,$6,'closed',150,50,100,$8,$3),(6,2,$6,'closed',100,0,150,$9,$3)`,
[advisor,snapshot(80),admin,snapshot(30,20,0,[2]),snapshot(10,0,0,[2]),stranger,snapshot(10,0,0,[2]),snapshot(100,0,50,[3]),snapshot(150,50,0,[2],'manual-bootstrap')]);
await db.query(`select public.record_commission_payment_v1('00000000-0000-4000-8000-000000000010',1,1,80,0,null,current_date,null)`);
await db.query('update public.advisor_commission_closures set advisor_user_id=$1 where id=4',[admin]);
await db.query(`select public.record_commission_payment_v1('00000000-0000-4000-8000-000000000011',5,1,100,0,null,current_date,null)`);
await db.exec(migration);
await db.exec(readFileSync(new URL('../../supabase/migrations/20261014150135_commission_carry_rpc_only_access.sql',import.meta.url),'utf8'));

async function state(id: number) {
  return (await db.query<{ v: { pendingUsd: number; retainedUsd: number; carriedCommissionUsd: number; orders: unknown[]; transferredToClosureId: number } }>('select app_private.commission_collection_state_v1($1) v',[id])).rows[0].v;
}
async function pay(key: string, amount: number) {
  return (await db.query<{ v: { replayed: boolean } }>('select public.record_commission_payment_v1($1,1,1,$2,0,null,current_date,null) v',[key,amount])).rows[0].v;
}

test('live collections, supplemental payments and exclusive transfers use real Postgres rules', async (t) => {
  try {
    await t.test('imports only a historical confirmed carry, not a preliminary copied balance',async()=>{
      const rows=(await db.query('select source_closure_id,destination_closure_id from advisor_commission_carry_transfers')).rows;
      assert.deepEqual(rows,[{source_closure_id:5,destination_closure_id:6}]);
      assert.equal((await state(2)).carriedCommissionUsd,0);
      assert.equal((await state(5)).pendingUsd,0);
      assert.equal((await state(6)).carriedCommissionUsd,50);
    });
    const original=(await db.query('select snapshot,payable_usd from advisor_commission_closures where id=1')).rows[0];
    await t.test('paid agreement starts with retained debt; no premature payout',async()=>{
      assert.equal((await state(1)).pendingUsd,0);
      assert.equal((await state(1)).retainedUsd,20);
      await assert.rejects(pay('00000000-0000-4000-8000-000000000012',1),/supera/);
    });
    await t.test('partial customer payment releases only the reduction in debt',async()=>{
      await db.exec('update orders set pending_usd=10 where id=1');
      assert.equal((await state(1)).pendingUsd,10);
      const key='00000000-0000-4000-8000-000000000013';
      assert.equal((await pay(key,10)).replayed,false);
      assert.equal((await pay(key,10)).replayed,true);
      await assert.rejects(pay(key,9),/otros datos/);
      assert.equal((await state(1)).pendingUsd,0);
      assert.deepEqual((await db.query('select snapshot,payable_usd from advisor_commission_closures where id=1')).rows[0],original);
    });
    await t.test('confirmed transfers are atomic, exclusive and idempotent',async()=>{
      await db.query("select public.transfer_commission_collection_v1(1,2,'Continuar cobranza')");
      assert.equal((await state(1)).pendingUsd,0);
      assert.equal((await state(2)).carriedCommissionUsd,10);
      assert.equal((await state(2)).retainedUsd,10);
      await db.query("select public.transfer_commission_collection_v1(1,2,'Continuar cobranza')");
      assert.equal((await db.query('select count(*)::int n from advisor_commission_carry_transfers where source_closure_id=1')).rows[0].n,1);
      await assert.rejects(db.query("select public.transfer_commission_collection_v1(1,3,'Otro destino')"),/ya fue transferido/);
      await assert.rejects(pay('00000000-0000-4000-8000-000000000014',1),/transferido/);
      assert.deepEqual((await db.query('select snapshot,payable_usd from advisor_commission_closures where id=1')).rows[0],original);
    });
    await t.test('after transfer a customer payment releases credit only in the destination',async()=>{
      await db.exec('update orders set pending_usd=0 where id=1');
      assert.equal((await state(1)).pendingUsd,0);
      assert.equal((await state(2)).pendingUsd,20);
      assert.equal((await state(2)).orders.length,2);
    });
    await t.test('wrong advisor, reverse date and stale confirmation are rejected',async()=>{
      await assert.rejects(db.query("select public.transfer_commission_collection_v1(4,3,'Otro asesor')"),/mismo asesor/);
      await assert.rejects(db.query("select public.confirm_commission_collection_v1(2,'{}'::jsonb)"),/cambió/);
    });
    await t.test('destination confirms and pays the owned credit once, without rewriting its source',async()=>{
      await db.query('update advisor_commission_closures set payable_usd=20,pending_collection_usd=0,snapshot=$1 where id=2',[snapshot(20,10,0,[2])]);
      const target=(await db.query('select snapshot from advisor_commission_closures where id=2')).rows[0].snapshot;
      await db.query('select public.confirm_commission_collection_v1(2,$1)',[target]);
      const result=(await db.query<{v:{fullyPaid:boolean}}>("select public.record_commission_payment_v1('00000000-0000-4000-8000-000000000015',2,1,20,0,null,current_date,null) v")).rows[0].v;
      assert.equal(result.fullyPaid,true);
      assert.equal((await state(2)).pendingUsd,0);
      assert.equal((await db.query("select sum(m.amount_usd_equivalent)::float8 total from commission_payment_operations o join money_movements m on m.id=o.payment_movement_id where o.closure_id in (1,2) and m.status='confirmed'")).rows[0].total,110);
      await assert.rejects(db.exec("update advisor_commission_closures set status='preliminary' where id=1"),/recalcular|trasladado/);
    });
    await t.test('reversing a destination payment restores only its own pending balance',async()=>{
      await db.query("select public.reverse_commission_payment_v1('00000000-0000-4000-8000-000000000016','00000000-0000-4000-8000-000000000015','Error de registro')");
      assert.equal((await state(2)).pendingUsd,20);
      assert.equal((await state(1)).pendingUsd,0);
      await assert.rejects(db.query("select public.reverse_commission_payment_v1('00000000-0000-4000-8000-000000000017','00000000-0000-4000-8000-000000000013','Intento duplicado')"),/transferido/);
    });
    await t.test('unverified canonical orders fail closed',async()=>{
      await db.exec('alter table orders rename to missing_orders');
      await assert.rejects(state(2));
      await db.exec('alter table missing_orders rename to orders');
    });
    await t.test('anonymous and other advisors cannot read or write the collections ledger',async()=>{
      await db.exec(`set test.uid='${stranger}'; set role authenticated`);
      await assert.rejects(db.query('select public.advisor_commission_collections_v1(array[1]::bigint[])'),/No puedes/);
      await assert.rejects(db.query("select public.transfer_commission_collection_v1(4,3,'Sin permiso')"),/administración/);
      await assert.rejects(db.query('delete from advisor_commission_carry_transfers'),/permission denied/);
      await assert.rejects(db.query('select * from advisor_commission_carry_transfers'),/permission denied/);
      await db.exec(`reset role; set test.uid='${advisor}'; set role authenticated`);
      assert.equal((await db.query('select jsonb_array_length(public.advisor_commission_collections_v1(array[1]::bigint[])) n')).rows[0].n,1);
      await db.exec('reset role; set role anon');
      await assert.rejects(db.query('select public.advisor_commission_collections_v1(array[1]::bigint[])'),/permission denied/);
      await db.exec(`reset role; set test.uid='${admin}'`);
    });
    await t.test('existing guards still reject editing an agreed amount or its deductions',async()=>{
      await assert.rejects(db.exec('update advisor_commission_closures set payable_usd=100 where id=1'),/recalcular/);
      await assert.rejects(db.exec("insert into advisor_commission_deductions(closure_id,deduction_type,amount_usd) values(1,'manual_expense',1)"),/deducciones/);
    });
  } finally { await db.close(); }
});
